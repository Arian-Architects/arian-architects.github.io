---
import { getImages } from '@/imagekit'
import MainLayout from '@/layouts/MainLayout.astro'

export async function getStaticPaths() {
  const allImages = await getImages()
  const allProjects = {}
  allImages.forEach((i) => {
    const tmp = i.filePath
    const split = tmp.split('/').filter(Boolean)
    const project = split[0]
    if (!allProjects[project]) allProjects[project] = []
    allProjects[project].push(i)
  })
  return Object.keys(allProjects).map((i) => ({ params: { slug: i }, props: { images: allProjects[i] } }))
}

const { slug } = Astro.params

const specificProj = Astro.props

const VIDEO_EXTENSIONS = new Set(['.mp4', '.webm', '.mov', '.ogg', '.m4v', '.avi'])

/** @param {string} path */
function isVideoFile(path) {
  const lower = path.toLowerCase()
  const i = lower.lastIndexOf('.')
  return i !== -1 && VIDEO_EXTENSIONS.has(lower.slice(i))
}

/** @param {string} filePath */
function getLambdaGroup(filePath) {
  const name = filePath.split('/').pop() || ''
  if (!name.includes('LAMBDA')) return null
  const before = name.split(/LAMBDA/i)[0] || ''
  return before.replace(/-+$/, '').trim() || null
}

const imagesWithGroup = specificProj.images.map((img) => ({
  ...img,
  group: getLambdaGroup(img.filePath || ''),
  isVideo: isVideoFile(img.filePath || img.url || ''),
}))
const lambdaGroups = [...new Set(imagesWithGroup.map((i) => i.group).filter(Boolean))].sort()

/** Images grouped by Lambda group for panel galleries; when no groups, null */
const galleryPanels =
  lambdaGroups.length > 0
    ? [
        { key: 'all', images: imagesWithGroup, label: 'All' },
        ...lambdaGroups.map((key) => ({
          key,
          images: imagesWithGroup.filter((i) => i.group === key),
          label: key.replace(/-/g, ' '),
        })),
      ]
    : null

/** @param {typeof imagesWithGroup} imgs */
function renderGalleryColumns(imgs) {
  const total = imgs.length
  const perCol = Math.floor(total / 3) || 1
  return [0, 1, 2].map((columnIndex) => imgs.slice(perCol * columnIndex, perCol * (columnIndex + 1)))
}
---

<MainLayout content={{ title: `${slug.split(',')[0]} - Arian Architects` }}>
  <div class="flex flex-col items-center space-y-8 pt-8 text-center">
    <h1 class="text-4xl text-black sm:text-6xl">{slug.split(',')[0]}</h1>
    <h2 class="text-4xl text-gray-500 sm:text-6xl">{slug.split(',')[1]}</h2>
    <a aria-label="Project Images" href="#project">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"></path>
      </svg>
    </a>
    <div id="project" class="mt-10 h-[1px] w-full bg-gray-200 px-4 md:px-32"></div>
  </div>
  {
    galleryPanels ? (
      <>
        <div class="flex flex-wrap justify-center gap-2 px-8 pt-4" id="gallery-filters" role="tablist">
          {galleryPanels.map((panel, i) => (
            <button type="button" class={`gallery-filter-btn ${i === 0 ? 'is-active' : ''}`} data-gallery-filter={panel.key} role="tab">
              {panel.label}
            </button>
          ))}
        </div>
        {galleryPanels.map((panel, panelIndex) => {
          const columns = renderGalleryColumns(panel.images)
          return (
            <div
              id={`my-gallery-${panel.key.replace(/\s+/g, '-')}`}
              class={`gallery-panel row p-8 ${panelIndex > 0 ? 'gallery-panel-hidden' : ''} ${panel.images.length === 1 ? 'gallery-panel-single' : ''}`}
              data-gallery-panel={panel.key}
              role="tabpanel"
            >
              {columns.map((columnImages) => (
                <div class="column">
                  {columnImages.map(({ url: image, width, height, isVideo }, index) => {
                    const thumbUrl = `${image}?tr=bl-20,w-200,h-200`
                    const isFirst = panelIndex === 0 && index === 0
                    if (isVideo) {
                      return (
                        <div class="media-wrap video-wrap lazy-media" data-src={image} data-width={width} data-height={height}>
                          <video width={width} height={height} controls preload="none" class="gallery-video" aria-label={`Video ${index} - ${slug.split(',')[0]}`} />
                        </div>
                      )
                    }
                    return (
                      <a href={image} data-pswp-width={width} data-pswp-height={height} class="img-wrap lazy-media" data-src={image} data-thumb={thumbUrl}>
                        <span class="img-placeholder">
                          <img data-thumb={thumbUrl} width={width} height={height} alt="" aria-hidden="true" decoding="async" loading="lazy" class="img-placeholder-img" />
                        </span>
                        <img data-src={image} width={width} height={height} decoding="async" class="img-full" alt={`Image ${index} - ${slug.split(',')[0]}`} />
                      </a>
                    )
                  })}
                </div>
              ))}
            </div>
          )
        })}
      </>
    ) : (
      <div id="my-gallery" class={`row p-8 ${imagesWithGroup.length === 1 ? 'gallery-single' : ''}`}>
        {new Array(3).fill(0).map((_, columnIndex) => (
          <div class="column">
            {imagesWithGroup
              .slice(Math.floor(imagesWithGroup.length / 3) * columnIndex, Math.floor(imagesWithGroup.length / 3) * (columnIndex + 1))
              .map(({ url: image, width, height, isVideo }, index) => {
                const thumbUrl = `${image}?tr=bl-20,w-200,h-200`
                if (isVideo) {
                  return (
                    <div class="media-wrap video-wrap lazy-media" data-src={image} data-width={width} data-height={height}>
                      <video width={width} height={height} controls preload="none" class="gallery-video" aria-label={`Video ${index} - ${slug.split(',')[0]}`} />
                    </div>
                  )
                }
                return (
                  <a href={image} data-pswp-width={width} data-pswp-height={height} class="img-wrap lazy-media" data-src={image} data-thumb={thumbUrl}>
                    <span class="img-placeholder">
                      <img data-thumb={thumbUrl} width={width} height={height} alt="" aria-hidden="true" decoding="async" loading="lazy" class="img-placeholder-img" />
                    </span>
                    <img data-src={image} width={width} height={height} decoding="async" class="img-full" alt={`Image ${index} - ${slug.split(',')[0]}`} />
                  </a>
                )
              })}
          </div>
        ))}
      </div>
    )
  }
</MainLayout>

<style>
  .img-wrap {
    display: block;
    position: relative;
    overflow: hidden;
  }
  .img-placeholder {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .img-placeholder,
  .img-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .img-placeholder {
    background: #e5e7eb;
  }
  .media-wrap.video-wrap:not(.lazy-loaded) {
    background: #e5e7eb;
    min-height: 200px;
  }
  .img-full {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .img-full.is-loaded {
    opacity: 1;
  }
  .gallery-filter-btn {
    padding: 0.5rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    background: #fff;
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .gallery-filter-btn:hover {
    background: #f3f4f6;
    border-color: #9ca3af;
  }
  .gallery-filter-btn.is-active {
    background: #111;
    color: #fff;
    border-color: #111;
  }
  .gallery-panel.gallery-panel-hidden {
    display: none !important;
  }
  .gallery-panel-single.row,
  #my-gallery.gallery-single.row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gallery-panel-single .column,
  #my-gallery.gallery-single .column {
    max-width: 800px;
    flex: 0 1 auto;
  }
  .media-wrap.video-wrap {
    display: block;
    position: relative;
    overflow: hidden;
  }
  .gallery-video {
    width: 100%;
    height: auto;
    display: block;
    vertical-align: middle;
  }
</style>

<script>
  import 'photoswipe/style.css'
  import pswpModule from 'photoswipe'
  import PhotoSwipeLightbox from 'photoswipe/lightbox'

  const LAZY_ROOT_MARGIN = '200px 0px 400px 0px'

  function setupLazyMedia() {
    const lazyEls = document.querySelectorAll('.lazy-media:not(.lazy-loaded)')
    if (lazyEls.length === 0) return

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const wrap = entry.target as HTMLElement
          if (wrap.classList.contains('lazy-loaded')) return
          wrap.classList.add('lazy-loaded')

          if (wrap.classList.contains('img-wrap')) {
            const thumb = wrap.querySelector<HTMLImageElement>('.img-placeholder-img')
            const full = wrap.querySelector<HTMLImageElement>('.img-full')
            const thumbSrc = wrap.dataset.thumb
            const fullSrc = wrap.dataset.src
            if (thumb && thumbSrc) {
              thumb.src = thumbSrc
            }
            if (full && fullSrc) {
              full.src = fullSrc
            }
          } else if (wrap.classList.contains('video-wrap')) {
            const video = wrap.querySelector<HTMLVideoElement>('video')
            const src = wrap.dataset.src
            if (video && src) {
              video.src = src
              video.load()
            }
          }
        })
      },
      { rootMargin: LAZY_ROOT_MARGIN, threshold: 0.01 },
    )
    lazyEls.forEach((el) => io.observe(el))
  }

  function setupImgLoaded() {
    document.querySelectorAll('.img-full').forEach((el) => {
      const img = el as HTMLImageElement
      const removePlaceholder = () => {
        img.classList.add('is-loaded')
        const placeholder = img.parentElement?.querySelector('.img-placeholder')
        if (placeholder) placeholder.remove()
      }
      if (img.src && img.complete) removePlaceholder()
      else img.addEventListener('load', removePlaceholder)
    })
  }

  function initPhotoSwipe() {
    const panels = document.querySelectorAll('.gallery-panel')
    if (panels.length > 0) {
      panels.forEach((panel) => {
        const id = panel.id
        if (!id) return
        new PhotoSwipeLightbox({
          pswpModule,
          children: 'a',
          gallery: `#${id}`,
        }).init()
      })
    } else {
      const gallery = document.getElementById('my-gallery')
      if (gallery) {
        new PhotoSwipeLightbox({
          pswpModule,
          children: 'a',
          gallery: '#my-gallery',
        }).init()
      }
    }
  }

  document.addEventListener(
    'astro:page-load',
    () => {
      setupLazyMedia()
      setupImgLoaded()

      const galleryRoot = document.getElementById('my-gallery') ?? document.querySelector('.gallery-panel:not(.gallery-panel-hidden)')
      let lightboxInited = false
      if (galleryRoot) {
        const galleryIo = new IntersectionObserver(
          (entries) => {
            if (lightboxInited) return
            if (!entries[0]?.isIntersecting) return
            lightboxInited = true
            initPhotoSwipe()
          },
          { rootMargin: '100px', threshold: 0 },
        )
        galleryIo.observe(galleryRoot)
      } else {
        initPhotoSwipe()
      }

      const filtersEl = document.getElementById('gallery-filters')
      if (filtersEl) {
        const panelEls = document.querySelectorAll('.gallery-panel')
        filtersEl.querySelectorAll('.gallery-filter-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const filter = (btn as HTMLButtonElement).dataset.galleryFilter
            if (!filter) return
            filtersEl.querySelectorAll('.gallery-filter-btn').forEach((b) => b.classList.remove('is-active'))
            btn.classList.add('is-active')
            panelEls.forEach((el) => {
              if (el.getAttribute('data-gallery-panel') === filter) el.classList.remove('gallery-panel-hidden')
              else el.classList.add('gallery-panel-hidden')
            })
            setupLazyMedia()
          })
        })
      }
    },
    { once: false },
  )
</script>
